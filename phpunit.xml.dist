<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         executionOrder="random"
         failOnWarning="true"
         failOnRisky="true"
         failOnEmptyTestSuite="true"
         beStrictAboutOutputDuringTests="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Cinder PHP">
            <directory>packages/cinder-php/tests</directory>
        </testsuite>
        <testsuite name="Cinder Laravel">
            <directory>packages/cinder-laravel/tests</directory>
        </testsuite>
        <testsuite name="Cinder WordPress">
            <directory>packages/cinder-wordpress/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">packages/cinder-php/src</directory>
            <directory suffix=".php">packages/cinder-laravel/src</directory>
            <directory suffix=".php">packages/cinder-wordpress/src</directory>
        </include>
    </source>
</phpunit>
